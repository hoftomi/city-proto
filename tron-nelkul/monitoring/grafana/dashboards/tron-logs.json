        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "logger",
          "stream": "{app=\"tron-backend\"}",
          "type": 1,
          "refId": "logger"
        },
        "definition": "label_values({app=\"tron-backend\"}, logger)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
