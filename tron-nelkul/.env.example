# Másold .env néven, és töltsd ki. A docker compose automatikusan beolvassa.
JWT_SECRET=ide-egy-legalabb-32-karakteres-veletlen-titok-kell
DEV_LOGIN=true
# Google: az Android, az iOS és a webes OAuth kliensazonosító, vesszővel elválasztva
GOOGLE_CLIENT_IDS=
# Apple: az iOS alkalmazás bundle ID-ja (pl. hu.webstar.tronnelkul)
APPLE_AUDIENCES=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
